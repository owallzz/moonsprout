# M5.3b lockstep package (docs/online/M5_3B_LOCKSTEP.md): included by CMakeLists.txt (step 0).
# The session sources under port/net/session/ are already in the mppm target (port/ glob); this fragment
# adds the build-flags header of the build hash (D19), the default lobby server for the session code and
# the p2net_selftest target.

# ---- Build flags for the build hash: compiler, P2_OPTIONS, P2_DEFINES, the libm and zero-init switches.
# The source directory is written as <src>, so two checkouts of one commit hash alike when the binaries do.
set(_mppm_build_flags "${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}|options=${P2_OPTIONS}|defines=${P2_DEFINES}|vendored_libm=${MPPM_VENDORED_LIBM}|zero_init=${MPPM_ZERO_INIT}")
string(REPLACE "${CMAKE_SOURCE_DIR}" "<src>" _mppm_build_flags "${_mppm_build_flags}")
string(REPLACE "\\" "\\\\" _mppm_build_flags "${_mppm_build_flags}")
string(REPLACE "\"" "\\\"" _mppm_build_flags "${_mppm_build_flags}")
file(CONFIGURE OUTPUT ${CMAKE_BINARY_DIR}/generated/mppm_build_flags.h
        CONTENT "// Generated by cmake/mppm_net_session.cmake (M5.3b build hash, D19). Do not edit.\n#pragma once\n#define MPPM_BUILD_FLAGS \"@_mppm_build_flags@\"\n"
        @ONLY)

# ---- The default lobby server (the same cache string as CMakeLists.txt, which defines it after this
# fragment) for mppm::online in port/net/session/session.cpp. Empty until the official server exists.
set(MPPM_DEFAULT_SERVER_URL "https://moonsprout-lobby.fly.dev" CACHE STRING "Default lobby server URL for online play (empty = none)")
set_property(SOURCE ${CMAKE_SOURCE_DIR}/port/net/session/session.cpp APPEND PROPERTY
        COMPILE_DEFINITIONS "MPPM_DEFAULT_SERVER_URL=\"${MPPM_DEFAULT_SERVER_URL}\"")

# ---- p2net_selftest: the pure session parts and the netsim lockstep cases, under ASan and UBSan.
# `ninja -C build-pc p2net_selftest && ./build-pc/p2net_selftest [-v] [case ...]`. Not in the default build.
set(P2NET_SELFTEST_SOURCES
        ${CMAKE_SOURCE_DIR}/tests/net/session/selftest.cpp
        ${CMAKE_SOURCE_DIR}/tests/net/session/netsim.cpp
        ${CMAKE_SOURCE_DIR}/port/net/session/wire.cpp
        ${CMAKE_SOURCE_DIR}/port/net/session/clock_sync.cpp
        ${CMAKE_SOURCE_DIR}/port/net/session/delay.cpp
        ${CMAKE_SOURCE_DIR}/port/net/session/host_core.cpp
        ${CMAKE_SOURCE_DIR}/port/net/session/client_core.cpp
        ${CMAKE_SOURCE_DIR}/port/net/session/endpoint.cpp
        ${CMAKE_SOURCE_DIR}/port/net/session/mem_transport.cpp
        ${CMAKE_SOURCE_DIR}/port/net/session/game_side.cpp)
add_executable(p2net_selftest EXCLUDE_FROM_ALL ${P2NET_SELFTEST_SOURCES})
target_compile_features(p2net_selftest PRIVATE cxx_std_20)
target_include_directories(p2net_selftest PRIVATE ${CMAKE_SOURCE_DIR}/port/include)
target_link_libraries(p2net_selftest PRIVATE nlohmann_json::nlohmann_json Threads::Threads)
option(MPPM_NET_SELFTEST_SANITIZE "Build p2net_selftest with AddressSanitizer and UndefinedBehaviorSanitizer" ON)
if (MPPM_NET_SELFTEST_SANITIZE AND CMAKE_CXX_COMPILER_FRONTEND_VARIANT STREQUAL "GNU")
    target_compile_options(p2net_selftest PRIVATE -fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer)
    target_link_options(p2net_selftest PRIVATE -fsanitize=address,undefined)
endif ()
